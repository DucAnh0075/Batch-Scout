# Anthropic API key — required ONLY for live scoring (intake?score=1, the Re-score button,
# and POST /api/applications/[id]/score). The seeded demo runs fully without it.
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown).
# SCORING_MODEL=claude-sonnet-4-6
# PREFILTER_MODEL=claude-haiku-4-5
